# --- Cloud infra ---
# Neon Postgres, DIRECT (non-pooled) connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Redis Cloud
REDIS_URL=redis://default:PASSWORD@HOST:PORT
# Elastic Cloud
ELASTICSEARCH_URL=https://YOUR-DEPLOYMENT.es.REGION.cloud.es.io:443
ELASTICSEARCH_API_KEY=your-elastic-api-key

# --- Server ---
PORT=4000
BACKEND_URL=http://localhost:4000
# ngrok static domain forwarding to PORT (used for Slack callback)
PUBLIC_URL=https://YOUR-DOMAIN.ngrok-free.app
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# --- Slack OAuth ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://YOUR-DOMAIN.ngrok-free.app/slack/callback

# --- Scheduler tuning ---
WORKER_CONCURRENCY=5
MIN_SEND_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=50
